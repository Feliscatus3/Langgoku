# Google Sheets Configuration
NEXT_PUBLIC_GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
NEXT_PUBLIC_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Google Apps Script Web App URL
GOOGLE_APPS_SCRIPT_URL=YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL
# Optional: when set, the Apps Script must have the same API_SECRET in
# File > Project settings > Script properties.
GOOGLE_APPS_SCRIPT_SECRET=

# Public base URL used for metadata and payment callbacks
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin Credentials (server-only, never prefix with NEXT_PUBLIC_)
ADMIN_USERNAME=adminku
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# Optional secret used to sign the admin session cookie. Defaults to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# DOKU Payment Gateway (server-only)
DOKU_CLIENT_ID=YOUR_DOKU_CLIENT_ID
DOKU_SECRET_KEY=YOUR_DOKU_SECRET_KEY
DOKU_IS_PRODUCTION=false
DOKU_PARTNER_SERVICE_ID=YOUR_PARTNER_SERVICE_ID
# DOKU SNAP virtual-account target path, adjust to your DOKU contract
DOKU_VA_TARGET=/virtual-account/bank-transfer/va
